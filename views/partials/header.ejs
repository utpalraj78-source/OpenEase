<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' | OpenEase' : 'OpenEase' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Lato:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script>document.documentElement.className += ' js';</script>
</head>
<body>
<header class="topbar" id="topbar">
  <div class="wrap topbar-inner">
    <a href="/" class="brand">
      <span class="brand-mark"><span>OE</span></span>
      <span class="brand-text">
        <strong>OpenEase</strong>
        <small>Open House Portal</small>
      </span>
    </a>

    <% if (currentUser) { %>
      <a href="/notifications" class="bell bell-mobile" title="Notifications">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>
        <% if (unreadCount) { %><span class="count"><%= unreadCount %></span><% } %>
      </a>
    <% } %>
    <button type="button" class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="navDrawer">
      <span></span><span></span><span></span>
    </button>

    <div class="nav-drawer" id="navDrawer">
    <nav class="mainnav">
      <% const role = currentUser ? currentUser.role : null; %>
      <% function nav(href, label) { const on = path === href || (href === '/events' && path.startsWith('/events/')) || (href === '/my/registrations' && path.startsWith('/my/')); %>
        <a href="<%= href %>" class="<%= on ? 'active' : '' %>"><%= label %></a>
      <% } %>

      <% if (!role || role === 'STUDENT_PARENT') { %>
        <% nav('/events', 'Events') %>
      <% } %>
      <% if (role === 'STUDENT_PARENT') { %>
        <% nav('/my/registrations', 'My bookings') %>
      <% } %>
      <% if (role === 'COORDINATOR' || role === 'ADMIN') { %>
        <% nav('/coordinator', 'My events') %>
        <% nav('/coordinator/events/new', 'Create event') %>
      <% } %>
      <% if (role === 'COORDINATOR') { %>
        <% nav('/coordinator/attendance', 'Attendance') %>
      <% } %>
      <% if (role === 'APPROVER' || role === 'ADMIN') { %>
        <% nav('/approver', 'Review queue') %>
      <% } %>
      <% if (role === 'COORDINATOR' || role === 'ADMIN' || role === 'MANAGEMENT') { %>
        <% nav('/reports', 'Reports') %>
      <% } %>
      <% if (role === 'ADMIN') { %>
        <% nav('/admin/users', 'Users') %>
      <% } %>
    </nav>

    <% if (!role || role === 'STUDENT_PARENT') { %>
      <form action="/events" method="get" class="nav-search">
        <input type="search" name="q" placeholder="Search events..." aria-label="Search events">
      </form>
    <% } %>

    <div class="userbox">
      <% if (currentUser) { %>
        <a href="/notifications" class="bell bell-desktop" title="Notifications">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>
          <% if (unreadCount) { %><span class="count"><%= unreadCount %></span><% } %>
        </a>
        <span class="who">
          <%= h.firstName(currentUser.fullName) %>
          <em><%= C.ROLE_LABELS[currentUser.role] %></em>
        </span>
        <form action="/logout" method="post" class="inline">
          <button class="linkbtn" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a href="/login" class="login-link">Log in</a>
        <a href="/register" class="btn">Register</a>
      <% } %>
    </div>
    </div>
  </div>
</header>

<%
  // coordinators get the left "workspace" sidebar from the UI mockups (UI-01 / UI-03)
  var withSide = currentUser && currentUser.role === 'COORDINATOR' &&
    (path.indexOf('/coordinator') === 0 || path === '/notifications');
  var sideOn = function (test) { return test ? 'on' : ''; };
%>
<main class="<%= typeof fullBleed !== 'undefined' && fullBleed ? 'page-full' : (withSide ? 'side-layout' : 'wrap page') %>">
  <% if (withSide) { %>
  <aside class="side-nav">
    <p class="side-label">Workspace</p>
    <a href="/coordinator" class="<%= sideOn(path === '/coordinator') %>"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>Dashboard</a>
    <a href="/coordinator/events" class="<%= sideOn(path.indexOf('/coordinator/events') === 0 && path !== '/coordinator/events/new' && title !== 'Create event') %>"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>My Events</a>
    <a href="/coordinator/events/new" class="<%= sideOn(path === '/coordinator/events/new' || title === 'Create event') %>"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>Create Event</a>
    <a href="/coordinator/attendance" class="<%= sideOn(path === '/coordinator/attendance' || path.indexOf('/coordinator/sessions') === 0) %>"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M16 11l2 2 4-4"/></svg>Attendance</a>
    <a href="/notifications" class="<%= sideOn(path === '/notifications') %>"><svg viewBox="0 0 24 24"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>Notifications<% if (unreadCount) { %><span class="side-count"><%= unreadCount %></span><% } %></a>
    <div class="side-help"><strong>Need help?</strong><br><span>Contact the admissions IT cell</span></div>
  </aside>
  <div class="side-main">
  <% } %>
  <% if (flashes.length) { %><div class="<%= typeof fullBleed !== 'undefined' && fullBleed ? 'wrap flash-holder' : '' %>"><% } %>
  <% flashes.forEach(function (f) { %>
    <div class="flash flash-<%= f.type %>"><%= f.msg %></div>
  <% }) %>
  <% if (flashes.length) { %></div><% } %>
