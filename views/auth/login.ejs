<%- include('../partials/header') %>

<div class="auth-layout">
  <div class="card auth-card">
    <h1>Log in</h1>
    <p class="muted">Students, parents, and institute staff (Local / LDAP Directory).</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash flash-error"><%= error %></div>
    <% } %>

    <form action="/login" method="post" class="form" novalidate>
      <label>Email or Institutional ID
        <input type="email" name="email" value="<%= email %>" placeholder="user@example.com or user@lnmiit.ac.in" required autofocus>
      </label>
      <label>Password
        <input type="password" name="password" required>
      </label>
      <button type="submit" class="btn btn-block">Log in</button>
    </form>
    <div class="mt-3 small" style="border-top: 1px solid #e2e8f0; padding-top: 0.75rem;">
      <p class="muted mb-1"><strong>Institutional LDAP:</strong> Faculty and staff may log in with their <code>@lnmiit.ac.in</code> credentials.</p>
      <p class="mb-0">New here? <a href="/register">Create a student / parent account</a>.</p>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
