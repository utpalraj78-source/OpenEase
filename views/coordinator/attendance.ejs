<%- include('../partials/header') %>
<%
  var d = new Date(session.event.schedule.eventDate);
  var counts = { PRESENT: 0, ABSENT: 0, PENDING: 0 };
  participants.forEach(function (p) { counts[p.status]++; });
%>

<p class="crumbs"><a href="/coordinator/attendance">Attendance</a> / Session Attendance</p>

<div class="page-head">
  <div>
    <h1 class="mb-1">Session Attendance</h1>
    <p class="muted">View registered visitors and record attendance for an open house session.</p>
  </div>
</div>

<div class="card att-head">
  <div class="att-date"><span><%= d.getDate() %></span><small><%= h.fmtDate(d).split(' ')[2] %></small></div>
  <div class="att-title">
    <p class="eyebrow">Open house event</p>
    <h2><%= session.event.title %></h2>
    <p class="muted small"><%= session.event.organizer || '' %></p>
  </div>
  <div class="att-facts">
    <div><span class="lbl">Session</span><%= session.sessionTitle %></div>
    <div><span class="lbl">Date</span><%= h.fmtDate(session.event.schedule.eventDate) %></div>
    <div><span class="lbl">Time</span><%= h.fmtTime(session.startTime) %> - <%= h.fmtTime(session.endTime) %></div>
    <div><span class="lbl">Venue</span><%= session.venue ? session.venue.roomNumber : '' %></div>
    <div><span class="lbl">Registered</span><strong><%= participants.length %> participants</strong></div>
  </div>
</div>

<div class="stat-cards">
  <div class="stat"><span class="ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.3c2.1.7 3.5 2.8 3.5 5.7"/></svg></span><div><small>Total Registered</small><strong id="mTotal"><%= participants.length %></strong></div></div>
  <div class="stat stat-green"><span class="ico">&#10003;</span><div><small>Present</small><strong id="mPresent"><%= counts.PRESENT %></strong></div></div>
  <div class="stat stat-red"><span class="ico">&#10007;</span><div><small>Absent</small><strong id="mAbsent"><%= counts.ABSENT %></strong></div></div>
  <div class="stat stat-amber"><span class="ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><div><small>Not Marked</small><strong id="mPending"><%= counts.PENDING %></strong></div></div>
</div>

<form method="post" action="/coordinator/sessions/<%= session._id %>/attendance" id="attendanceForm" class="card roster-card">
  <div class="roster-top">
    <div>
      <h3 class="mb-0">Attendance roster</h3>
      <p class="muted small">Only registered visitors for the selected session are listed.</p>
    </div>
    <div class="roster-btns">
      <span class="small muted" id="dirtyNote"></span>
      <button type="button" class="btn btn-ghost btn-sm" id="selectAll">Select all</button>
      <button type="button" class="btn btn-ghost btn-sm" id="resetSel">Reset</button>
      <button type="submit" class="btn btn-blue btn-sm" <%= participants.length ? '' : 'disabled' %>>Save attendance</button>
    </div>
  </div>

  <div class="filters">
    <input type="search" id="rosterSearch" placeholder="Search name, registration ID, or email">
    <span class="spacer"></span>
    <label class="small inline-label">Session
      <select onchange="location.href='/coordinator/sessions/' + this.value + '/attendance'">
        <% siblings.forEach(function (s) { %>
          <option value="<%= s._id %>" <%= String(s._id) === String(session._id) ? 'selected' : '' %>><%= s.sessionTitle %></option>
        <% }) %>
      </select>
    </label>
  </div>

  <% if (!participants.length) { %>
    <div class="empty"><p>No one is registered for this session.</p></div>
  <% } else { %>
  <table class="table roster" id="roster">
    <thead><tr><th class="w-check"><input type="checkbox" id="checkAll" aria-label="Select all"></th><th>S. No.</th><th>Registration ID</th><th>Visitor Name</th><th>Visitor Type</th><th>Registration</th><th>Attendance Status</th><th>Actions</th></tr></thead>
    <tbody>
      <% participants.forEach(function (p, i) { %>
        <tr data-status="<%= p.status %>" data-search="<%= (p.code + ' ' + p.name + ' ' + p.email).toLowerCase() %>">
          <td class="w-check"><input type="checkbox" class="js-row-check" aria-label="Select <%= p.name %>"></td>
          <td class="muted"><%= i + 1 %></td>
          <td><a class="reg-link"><%= p.code %></a></td>
          <td><strong><%= p.name %></strong><%= p.guests ? ' (+' + p.guests + ')' : '' %></td>
          <td><%= p.type === 'PARENT' ? 'Parent' : 'Prospective Student' %></td>
          <td><span class="badge badge-registered">Registered</span></td>
          <td><span class="badge js-badge badge-<%= p.status.toLowerCase() %>"><%= p.status === 'PENDING' ? 'Not marked' : h.statusLabel(p.status) %></span></td>
          <td class="nowrap">
            <input type="hidden" name="status[<%= p.registrationId %>]" value="<%= p.status %>" class="js-status">
            <div class="toggle">
              <button type="button" data-set="PRESENT" class="<%= p.status === 'PRESENT' ? 'on' : '' %>">Present</button>
              <button type="button" data-set="ABSENT" class="<%= p.status === 'ABSENT' ? 'on' : '' %>">Absent</button>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="pager">
    <span class="small muted" id="pageInfo"></span>
    <span class="spacer"></span>
    <div class="pages" id="pages"></div>
  </div>
  <% } %>
</form>

<%- include('../partials/footer') %>
