<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <h1 class="mb-1">My Events</h1>
    <p class="muted">Everything you have created, newest changes first.</p>
  </div>
  <a href="/coordinator/events/new" class="btn">+ Create event</a>
</div>

<% if (!events.length) { %>
  <div class="empty"><p>No events yet.</p></div>
<% } else { %>
  <table class="table">
    <thead><tr><th>ID</th><th>Title</th><th>Category</th><th>Date</th><th>Venue</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% events.forEach(function (e) { %>
        <tr>
          <td><code><%= e.eventId %></code></td>
          <td><a href="/coordinator/events/<%= e._id %>"><%= e.title %></a></td>
          <td><%= e.category ? e.category.categoryName : '-' %></td>
          <td class="nowrap"><%= e.schedule.eventDate ? h.fmtDate(e.schedule.eventDate) : '-' %></td>
          <td><%= e.venue ? e.venue.label : '-' %></td>
          <td><%- include('../partials/status', { status: e.status }) %></td>
          <td class="nowrap">
            <% if (['DRAFT', 'REVISION_REQUIRED'].indexOf(e.status) !== -1) { %><a href="/coordinator/events/<%= e._id %>/edit">Edit</a><% } else { %><a href="/coordinator/events/<%= e._id %>">Open</a><% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
