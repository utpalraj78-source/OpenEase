# OpenEase Environment Configuration
PORT=3000
SESSION_SECRET=replace-with-any-long-random-string

# PostgreSQL Database Configuration
# Default: Embedded zero-config PGlite database in ./data/pglite
# To connect to external PostgreSQL (e.g. Supabase, Neon, AWS RDS, local pg), uncomment:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/openease
# or:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=openease
